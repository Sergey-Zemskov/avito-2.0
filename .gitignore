# --- Служебные файлы Python ---
__pycache__/
*.py[cod]
.venv/
venv/

# --- Настройки редакторов ---
.vscode/
.idea/

# --- Фотографии, загруженные через сайт ---
# Папка demo остаётся в репозитории: это картинки демонстрационных
# объявлений, которые создаёт скрипт seed.py.
static/uploads/*
!static/uploads/.gitkeep
!static/uploads/demo/
!static/uploads/demo/**

# --- Файл базы данных (создаётся скриптом setup_all.py) ---
*.fdb
*.FDB
*.DB

# --- Журналы и временные файлы ---
*.log
*.tmp
